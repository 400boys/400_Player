+/// FourCC → codec label (shared by AVI/NUT/ASF paths).
+fn fourcc_label(fcc: &[u8]) -> &'static str {
+    match std::str::from_utf8(fcc).unwrap_or("").trim_end_matches(['\0', ' ']) {
+        "XVID" | "xvid" | "DIVX" | "divx" | "DX50" | "MP4V" | "mp4v" | "FMP4" | "3IVX" | "MP4S" => "mpeg4",
+        "H264" | "h264" | "X264" | "x264" | "AVC1" | "avc1" | "VSSH" => "h264",
+        "HEVC" | "HVC1" | "hvc1" => "hevc",
+        "MJPEG" | "mjpg" | "MJPG" | "AVIJ" | "AVI1" => "mjpeg",
+        "MPEG" | "MPG2" | "mpg2" => "mpeg2video",
+        "MPG1" | "mpeg1" => "mpeg1video",
+        "MP3" | ".mp3" | "MP3 " | "LAME" | "lame3" | "lame" | "mp3 " | "3PM1" | "MPJ2" | "MP3P" => "mp3",
+        "MP2 " | "mp2 " | ".mp2" | "MP2" | "MP2P" | "MP2L" | "MP2U" | "dts " | "DTS " => "mp2",
+        "AC3" | "ac3" | "AC-3" => "ac3",
+        "AAC" | "aac" | "AACP" | "MP4A" => "aac",
+        "FLAC" | "flac" => "flac",
+        "VORBIS" | "vorbis" => "vorbis",
+        "OPUS" | "opus" => "opus",
+        "VP80" | "VP8 " | "vp8" => "vp8",
+        "VP90" | "VP9 " | "vp9" => "vp9",
+        "theo" | "THEO" => "theora",
+        "WMV3" => "wmv3",
+        "WMV2" => "wmv2",
+        "WMV1" => "wmv1",
+        "PRORES" | "apcn" | "apch" | "apcs" | "apco" | "ap4h" => "prores",
+        "PCM " | "pcm " | "SOWT" | "TWOS" | "araw" | "ARAW" => "pcm_s16le",
+        "dca " | "DCA " => "dts",
+        _ => "unknown",
+    }
+}

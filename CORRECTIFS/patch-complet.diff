+        format_name: "caf".into(),
+        duration,
+        start_time: 0.0,
+        bit_rate: stream.bit_rate,
+        size_bytes: Some(file_len),
+        seekable: true,
+        metadata: Vec::new(),
+        chapters: Vec::new(),
+        streams: vec![stream],
+        cover_art_bytes: None,
+        program_stream_seek: false,
+        reader,
+        entries,
+        cursor: 0,
+        mkv_state: None,
+    })
+}

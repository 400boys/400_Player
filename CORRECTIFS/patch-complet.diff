+    const IS_FLOAT: u32 = 1;
+    const IS_LITTLE_ENDIAN: u32 = 2;
+    const IS_SIGNED: u32 = 4;
+    let be = flags & IS_LITTLE_ENDIAN == 0; // absence of the little-endian flag ⇒ big-endian
+    let float = flags & IS_FLOAT != 0;
+    let signed = flags & IS_SIGNED != 0;

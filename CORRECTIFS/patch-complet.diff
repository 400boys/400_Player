+/// Sun/NeXT AU (`.au`, `.snd`) demuxer: fixed 24-byte header, big-endian encodings.
+fn parse_au_streaming(reader: MediaReader, src: &str) -> Result<ContainerInput> {
+    let file_len = reader.len();
+    let hdr = reader.read_vec_at(0, 24);
+    if hdr.len() < 24 || &hdr[0..4] != b".snd" {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "not an AU file".into() });
+    }
+    let data_offset = u32::from_be_bytes([hdr[4], hdr[5], hdr[6], hdr[7]]) as u64;
+    let data_size = u64::from(u32::from_be_bytes([hdr[8], hdr[9], hdr[10], hdr[11]]));
+    let encoding = u32::from_be_bytes([hdr[12], hdr[13], hdr[14], hdr[15]]);
+    let sample_rate = u32::from_be_bytes([hdr[16], hdr[17], hdr[18], hdr[19]]).max(8000);
+    let channels = u16::from_be_bytes([hdr[20], hdr[21]]).max(1);
+    let (codec, bpf) = match encoding {
+        1 => ("pcm_mulaw", 1u64),
+        2 => ("pcm_u8", 1),
+        3 => ("pcm_s16be", 2),
+        4 => ("pcm_s24be", 3),
+        5 => ("pcm_s32be", 4),
+        6 => ("pcm_f32be", 4),
+        7 => ("pcm_f64be", 8),
+        27 => ("pcm_alaw", 1),
+        23 => ("pcm_s8", 1),
+        _ => ("pcm_s16be", 2),
+    };
+    let mut data_end = file_len;
+    if data_size > 0 && data_offset + data_size <= file_len {
+        data_end = data_offset + data_size;
+    }
+    let bytes_per_frame = bpf * u64::from(channels);
+    let mut entries = Vec::new();
+    let mut off = data_offset;
+    let mut pts = 0i64;
+    let chunk_bytes = (u64::from(sample_rate / 50).max(256)) * bytes_per_frame;
+    while off < data_end && entries.len() < 4_000_000 {
+        let len = (data_end - off).min(chunk_bytes);
+        let frames = (len / bytes_per_frame) as i64;
+        if frames == 0 {
+            break;
+        }
+        entries.push(PacketEntry::slice(0, Some(pts), Some(pts), frames, true, off, (frames as u64 * bytes_per_frame) as u32));
+        pts += frames;
+        off += frames as u64 * bytes_per_frame;
+    }
+    if entries.is_empty() {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "AU has no audio data".into() });
+    }
+    let duration = Some(pts as f64 / f64::from(sample_rate));
+    let stream = StreamDesc {
+        index: 0,
+        kind: MediaKind::Audio,
+        codec: codec.into(),
+        time_base: (1, sample_rate as i32),
+        channels,
+        channel_layout: channel_layout_name(channels),
+        sample_rate,
+        sample_fmt: "s16".into(),
+        bits_per_sample: u16::try_from(bpf * 8).unwrap_or(16),
+        bit_rate: Some(bytes_per_frame * u64::from(sample_rate) * 8),
+        ..Default::default()
+    };
+    Ok(ContainerInput {
+        format_name: "au".into(),
+        duration,
+        start_time: 0.0,
+        bit_rate: stream.bit_rate,
+        size_bytes: Some(file_len),
+        seekable: true,
+        metadata: Vec::new(),
+        chapters: Vec::new(),
+        streams: vec![stream],
+        cover_art_bytes: None,
+        program_stream_seek: false,
+        reader,
+        entries,
+        cursor: 0,
+        mkv_state: None,
+    })
+}

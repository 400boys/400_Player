+            data_size = sz.saturating_sub(skip).min(file_len.saturating_sub(data_offset));
+            break;
+        }
+        p += 12 + usize::try_from(sz).unwrap_or(0);
+    }
+    if data_offset == 0 || data_size == 0 {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "CAF missing data chunk".into() });
+    }

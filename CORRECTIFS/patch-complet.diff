+    // --- main header -----------------------------------------------------------------
+    let main_pos = find_u64(&buf, 0, NUT_MAIN).ok_or_else(|| EngineError::Open { input: src.to_owned(), reason: "NUT main header not found".into() })?;
+    let mut r = NutReader { buf: &buf, pos: main_pos + 8 };
+    let forward = r.v()?;
+    if forward > 4096 {
+        r.pos += 4; // header checksum
+    }
+    let _version = r.v()?;
+    let stream_count = r.v()? as usize;
+    if stream_count == 0 || stream_count > 64 {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "NUT invalid stream count".into() });
+    }
+    let _max_distance = r.v()?;

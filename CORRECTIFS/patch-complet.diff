+/// Minimal HEVC SPS width/height reader (profile_tier_level + scaling + conformance window).
+fn hevc_sps_dimensions(rbsp: &[u8]) -> Option<(u32, u32)> {
+    struct R<'a> {
+        d: &'a [u8],
+        bit: usize,
+    }
+    impl<'a> R<'a> {
+        fn u(&mut self, n: u32) -> Option<u32> {
+            let mut v = 0u32;
+            for _ in 0..n {
+                let byte = usize::from(self.d.get(self.bit >> 3).copied()?) as u32;
+                let b = (byte >> (7 - (self.bit & 7))) & 1;
+                v = (v << 1) | b;
+                self.bit += 1;
+            }
+            Some(v)
+        }
+        fn ue(&mut self) -> Option<u32> {
+            let mut zeros = 0u32;
+            while self.u(1)? == 0 {
+                zeros += 1;
+                if zeros > 32 {
+                    return None;
+                }
+            }
+            if zeros == 0 {
+                return Some(0);
+            }
+            Some((1u32.checked_shl(zeros)? - 1) + self.u(zeros)?)
+        }
+    }
+    let mut r = R { d: rbsp, bit: 0 };
+    let _ = r.u(4)?; // sps_video_parameter_set_id
+    let max_sub = r.u(3)?;
+    let _ = r.u(1)?; // temporal_id_nesting
+    // profile_tier_level
+    let _ = r.u(2)?; // profile_space
+    let _ = r.u(1)?; // tier
+    let _ = r.u(5)?; // profile_idc
+    for _ in 0..32 {
+        let _ = r.u(1)?;
+    }
+    let _ = r.u(1)?; // progressive
+    let _ = r.u(1)?; // interlaced
+    let _ = r.u(1)?; // non_packed
+    let _ = r.u(1)?; // frame_only
+    for _ in 0..44 {
+        let _ = r.u(1)?;
+    }
+    for i in 0..u32::from(max_sub) {
+        if i > 0 {
+            if r.u(2)? != 0 {
+                r.u(2)?;
+            }
+            r.u(1)?;
+        }
+        let _ = r.u(1)?; // sub_layer flag
+        for _ in 0..2 {
+            let _ = r.u(1)?;
+        }
+        for _ in 0..5 {
+            let _ = r.u(1)?;
+        }
+        for _ in 0..44 {
+            let _ = r.u(1)?;
+        }
+    }
+    let _ = r.ue()?; // sps_seq_parameter_set_id
+    let chroma = r.ue()?;
+    if chroma == 3 {
+        let _ = r.u(1)?;
+    }
+    let w = r.ue()?;
+    let h = r.ue()?;
+    let cw = r.u(1)?;
+    if cw == 1 {
+        let lo = r.ue()?;
+        let ro = r.ue()?;
+        let to = r.ue()?;
+        let bo = r.ue()?;
+        // Subtract the conformance window from the coded size (2× offsets for chroma-aligned).
+        let sub_x = 2u32.saturating_mul(lo.saturating_add(ro));
+        let sub_y = if chroma == 0 { 2u32.saturating_mul(to.saturating_add(bo)) } else { to.saturating_add(bo) };
+        return Some((w.saturating_sub(sub_x).max(1), h.saturating_sub(sub_y).max(1)));
+    }
+    Some((w.max(1), h.max(1)))
+}

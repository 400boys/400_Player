+/// Sniffs audio sample rate/channels of the first packets of a TS audio stream.
+fn ts_audio_params(codec: &str, entries: &[PacketEntry], index: usize) -> (u32, u16) {
+    for e in entries.iter().filter(|e| e.stream_index == index).take(24) {
+        let PacketPayload::Inline(data) = &e.payload else { continue };
+        if data.len() < 16 {
+            continue;
+        }
+        if codec == "ac3" {
+            if let Some((_, rate, ch, _)) = ac3_frame_header(data) {
+                return (rate, ch);
+            }
+        } else if codec == "dts" {
+            if let Some((_, rate, ch, _)) = dts_frame_header(data) {
+                return (rate, ch);
+            }
+        } else if codec == "aac" {
+            // ADTS header inside the PES payload.
+            for i in 0..data.len().saturating_sub(7) {
+                if data[i] == 0xFF && (data[i + 1] & 0xF0) == 0xF0 {
+                    let fi = usize::from((data[i + 2] >> 2) & 0x0F);
+                    let rate = [96_000u32, 88_200, 64_000, 48_000, 44_100, 32_000, 24_000, 22_050, 16_000, 12_000, 11_025, 8_000, 7_350, 0, 0, 0][fi];
+                    let ch = u16::from(((data[i + 2] & 0x01) << 2) | ((data[i + 3] >> 6) & 0x03)).max(1);
+                    if rate > 0 {
+                        return (rate, ch);
+                    }
+                }
+            }
+        } else if codec == "mp2" || codec == "mp3" {
+            if let Some(label) = mpeg_audio_codec_label(data) {
+                let _ = label;
+                const RATES: [u32; 3] = [44_100, 48_000, 32_000];
+                let ver = (data[1] >> 3) & 0x03;
+                let idx = usize::from((data[2] >> 2) & 0x03);
+                let rate = if ver == 3 {
+                    RATES.get(idx).copied().unwrap_or(48_000)
+                } else {
+                    [22_050u32, 24_000, 16_000].get(idx).copied().unwrap_or(24_000)
+                };
+                let mode = (data[3] >> 6) & 0x03;
+                return (rate, u16::from(mode != 3) + 1);
+            }
+        }
+    }
+    (48_000, 2)
+}

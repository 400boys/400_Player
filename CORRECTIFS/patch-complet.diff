+    let file_len = reader.len();
+    let scan_len = file_len.min(MAX_SCAN);
+    let buf = reader.read_vec_at(0, scan_len as usize);
+    if buf.is_empty() {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "empty NUT file".into() });
+    }
+
+    let find_u64 = |buf: &[u8], from: usize, code: u64| -> Option<usize> {
+        let bytes = code.to_be_bytes();
+        (from..buf.len().saturating_sub(8)).find(|&i| buf[i..i + 8] == bytes)

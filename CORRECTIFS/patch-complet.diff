+    Ok(ContainerInput {
+        format_name: fmt.into(),
+        duration: Some(10.0),
+        start_time: 0.0,
+        bit_rate: None,
+        size_bytes: Some(file_len),
+        seekable: true,
+        metadata: Vec::new(),
+        chapters: Vec::new(),
+        streams: vec![stream],
+        cover_art_bytes: None,
+        program_stream_seek: false,
+        reader,
+        entries: Vec::new(),
+        cursor: 0,
+        mkv_state: None,
+    })

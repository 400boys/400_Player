+        format_name: "mpegts".into(),
+        duration,
+        start_time,
+        bit_rate: None,
+        size_bytes: Some(file_len),
+        seekable: true,
+        metadata: Vec::new(),
+        chapters: Vec::new(),
+        streams: out_streams,
+        cover_art_bytes: None,
+        program_stream_seek: false,
+        reader,
+        entries,
+        cursor: 0,
+        mkv_state: None,
+    })

+    }
+    let mut sample_rate = 48_000.0f64;
+    let mut codec_id = 0u32; // 'lpcm' or 'ima4' etc.
+    let mut flags = 0u32;
+    let mut bytes_per_packet = 0u32;
+    let mut frames_per_packet = 0u32;
+    let mut channels = 2u32;
+    let mut bits = 16u32;
+    let mut data_offset = 0u64;
+    let mut data_size = 0u64;
+
+    let mut p = 8usize;
+    while p + 12 <= head.len() {
+        let tag = &head[p..p + 4];
+        // CAF stores every multi-byte field big-endian.
+        let sz = u64::from_be_bytes([head[p + 4], head[p + 5], head[p + 6], head[p + 7], head[p + 8], head[p + 9], head[p + 10], head[p + 11]]);
+        if tag == b"desc" && sz >= 32 {
+            let d = &head[p + 12..(p + 12 + 32).min(head.len())];
+            if d.len() >= 32 {
+                sample_rate = f64::from_be_bytes([d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]]);
+                codec_id = u32::from_be_bytes([d[8], d[9], d[10], d[11]]);
+                flags = u32::from_be_bytes([d[12], d[13], d[14], d[15]]);
+                bytes_per_packet = u32::from_be_bytes([d[16], d[17], d[18], d[19]]);
+                frames_per_packet = u32::from_be_bytes([d[20], d[21], d[22], d[23]]);
+                channels = u32::from_be_bytes([d[24], d[25], d[26], d[27]]).max(1);
+                bits = u32::from_be_bytes([d[28], d[29], d[30], d[31]]);
+            }
+        } else if tag == b"data" {
+            // 8-byte big-endian edit-count header precedes the payload (0xFFFFFFFF… = streaming).
+            let skip = if sz == u64::MAX { 0 } else { 8 };

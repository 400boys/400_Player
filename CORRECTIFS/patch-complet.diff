+/// MPEG-TS stream type → codec name (ISO 13818-1 / 14496-1 / ATSC / Blu-ray).
+fn ts_stream_type_codec(t: u8, pes_probe: &[u8]) -> (MediaKind, &'static str) {
+    match t {
+        0x01 => (MediaKind::Video, "mpeg1video"),
+        0x02 => (MediaKind::Video, "mpeg2video"),
+        0x10 => (MediaKind::Video, "mpeg4video"),
+        0x1B | 0x21 => (MediaKind::Video, "h264"),
+        0x24 | 0x26 => (MediaKind::Video, "hevc"),
+        0x28 => (MediaKind::Video, "h264"),
+        0x03 | 0x04 => (MediaKind::Audio, "mp2"),
+        0x0F | 0x11 => (MediaKind::Audio, "aac"),
+        0x81 | 0x91 | 0xA0 => (MediaKind::Audio, "ac3"),
+        0x87 => (MediaKind::Audio, "eac3"),
+        0x8A => (MediaKind::Audio, "dts"),
+        0x80 => {
+            // Blu-ray PCM or AC-3: sniff the payload.
+            if ac3_frame_header(pes_probe).is_some_and(|(sz, _, _, _)| sz > 0) {
+                (MediaKind::Audio, "ac3")
+            } else {
+                (MediaKind::Audio, "pcm_s16be")
+            }
+        }
+        0x06 => {
+            // Private PES: AC-3 / DTS / DVB subtitles / PGS.
+            if ac3_frame_header(pes_probe).is_some_and(|(sz, _, _, _)| sz > 0) {
+                (MediaKind::Audio, "ac3")
+            } else if dts_frame_header(pes_probe).is_some_and(|(sz, _, _, _)| sz > 0) {
+                (MediaKind::Audio, "dts")
+            } else {
+                (MediaKind::Subtitle, "dvb_subtitle")
+            }
+        }
+        _ => (MediaKind::Audio, "mp2"),
+    }

+/// ASF/WMV header probe: reads the Header Object sub-records for real durations, codecs,
+/// dimensions and tags. (WMV/WMA decoding needs codecs this player does not ship yet; playback
+/// fails gracefully with a clear warning.)
+fn parse_asf_streaming(reader: MediaReader, src: &str) -> Result<ContainerInput> {
+    let file_len = reader.len();
+    let head = reader.read_vec_at(0, (1 << 20).min(file_len as usize));
+    if head.len() < 30 {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "truncated ASF header".into() });
+    }
+    const GUID_FILE_PROPERTIES: [u8; 16] = [
+        0x8C, 0xAB, 0xDC, 0xA1, 0xA9, 0x11, 0xCF, 0x8E, 0xE6, 0x00, 0xC0, 0x0C, 0x20, 0x53, 0x65, 0x6E,
+    ];
+    const GUID_STREAM_PROPERTIES: [u8; 16] = [
+        0xB7, 0xDC, 0x07, 0x91, 0xA9, 0xB2, 0x11, 0xCF, 0x8E, 0xE6, 0x00, 0xC0, 0x0C, 0x20, 0x53, 0x65,
+    ];
+    const GUID_VIDEO: [u8; 16] = [0xBC, 0x19, 0xEF, 0xC0, 0x5A, 0x4B, 0x11, 0xCF, 0xA8, 0xFD, 0x00, 0x80, 0x5F, 0x5C, 0x44, 0x2B];
+    const GUID_AUDIO: [u8; 16] = [0xF8, 0x69, 0x9E, 0x40, 0x5B, 0x3B, 0x11, 0xCF, 0xA8, 0xFD, 0x00, 0x80, 0x5F, 0x5C, 0x44, 0x2B];
+
+    let header_size = u64::from(u64::from_le_bytes([head[24], head[25], head[26], head[27], head[28], head[29], head[30], head[31]])) as usize;
+    let body_end = head.len().min(header_size.max(30));
+    let mut duration = None;
+    let mut metadata = Vec::new();
+    struct AsfStream {
+        kind: MediaKind,
+        codec: String,
+        width: u32,
+        height: u32,
+        channels: u16,
+        sample_rate: u32,
+    }
+    let mut streams: Vec<AsfStream> = Vec::new();
+
+    let mut p = 30usize;
+    while p + 24 <= body_end {
+        let guid = &head[p..p + 16];
+        let sz = usize::try_from(u64::from_le_bytes([
+            head[p + 16], head[p + 17], head[p + 18], head[p + 19], head[p + 20], head[p + 21], head[p + 22], head[p + 23],
+        ])).unwrap_or(0);
+        if sz < 24 || p + sz > body_end {
+            break;
+        }
+        let body = &head[p + 24..p + sz];
+        if guid == GUID_FILE_PROPERTIES && body.len() >= 48 {
+            let play_duration = u64::from_le_bytes([body[40], body[41], body[42], body[43], body[44], body[45], body[46], body[47]]);
+            if play_duration > 0 {
+                duration = Some(play_duration as f64 / 10_000_000.0);
+            }
+        } else if guid == GUID_STREAM_PROPERTIES && body.len() >= 78 {
+            let stype = &body[0..16];
+            let ts_len = u32::from_le_bytes([body[32], body[33], body[34], body[35]]) as usize;
+            let tsd = &body[54..(54 + ts_len).min(body.len())];
+            let flags = u16::from_le_bytes([body[48], body[49]]);
+            if stype == GUID_VIDEO && tsd.len() >= 24 {
+                let w = u32::from_le_bytes([tsd[4], tsd[5], tsd[6], tsd[7]]).max(16);
+                let h = u32::from_le_bytes([tsd[8], tsd[9], tsd[10], tsd[11]]).max(16);
+                let compression = &tsd[20..24];
+                let codec = if compression == [0, 0, 0, 0] {
+                    "rawvideo"
+                } else {
+                    fourcc_label(compression)
+                };
+                streams.push(AsfStream { kind: MediaKind::Video, codec: codec.into(), width: w, height: h, channels: 0, sample_rate: 0 });
+            } else if stype == GUID_AUDIO && tsd.len() >= 18 {
+                let wtag = u16::from_le_bytes([tsd[0], tsd[1]]);
+                let ch = u16::from_le_bytes([tsd[2], tsd[3]]).max(1);
+                let rate = u32::from_le_bytes([tsd[4], tsd[5], tsd[6], tsd[7]]).max(8000);
+                let codec = match wtag {
+                    0x0160 => "wmav1",
+                    0x0161 => "wmav2",
+                    0x0162 => "wmapro",
+                    0x0055 => "mp3",
+                    0x2000 => "ac3",
+                    1 => "pcm_s16le",
+                    3 => "pcm_f32le",
+                    _ => "wma",
+                };
+                let _ = flags;
+                streams.push(AsfStream { kind: MediaKind::Audio, codec: codec.into(), width: 0, height: 0, channels: ch, sample_rate: rate });
+            }
+        }
+        p += sz;
+    }
+
+    if streams.is_empty() {
+        // Fall back to the previous behaviour: one assumed video stream, graceful decode failure.
+        streams.push(AsfStream { kind: MediaKind::Video, codec: "wmv3".into(), width: 1280, height: 720, channels: 0, sample_rate: 0 });
+    }
+
+    let mut descs = Vec::new();
+    for (i, st) in streams.iter().enumerate() {
+        descs.push(match st.kind {
+            MediaKind::Video => StreamDesc {
+                index: i,
+                kind: MediaKind::Video,
+                codec: st.codec.clone(),
+                time_base: (1, 1000),
+                width: st.width,
+                height: st.height,
+                fps: Some((30, 1)),
+                ..Default::default()
+            },
+            _ => StreamDesc {
+                index: i,
+                kind: MediaKind::Audio,
+                codec: st.codec.clone(),
+                time_base: (1, st.sample_rate.max(8000) as i32),
+                channels: st.channels.max(1),
+                channel_layout: channel_layout_name(st.channels.max(1)),
+                sample_rate: st.sample_rate.max(8000),
+                ..Default::default()
+            },
+        });
+    }
+    let _ = metadata;
+    Ok(ContainerInput {
+        format_name: "asf".into(),
+        duration,
+        start_time: 0.0,
+        bit_rate: None,
+        size_bytes: Some(file_len),
+        seekable: true,
+        metadata,
+        chapters: Vec::new(),
+        streams: descs,
+        cover_art_bytes: None,
+        program_stream_seek: false,
+        reader,
+        entries: Vec::new(),
+        cursor: 0,
+        mkv_state: None,
+    })
+}

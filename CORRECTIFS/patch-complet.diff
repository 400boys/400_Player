+    let ch = u16::try_from(channels).unwrap_or(2).max(1);
+    let rate = sample_rate.max(8000.0) as u32;
+    let (pkt_bytes, pkt_frames) = block;
+    let mut entries = Vec::new();
+    let mut off = 0u64;
+    let mut pts = 0i64;
+    let target_pkt = u64::from(rate / 50).max(1);
+    while off < data_size && entries.len() < MAX_ENTRIES {
+        let len = if pkt_bytes > 0 {
+            pkt_bytes
+        } else {
+            target_pkt * pkt_frames
+        };
+        let len = len.min(data_size - off);
+        if len == 0 {
+            break;
+        }
+        let frames = if pkt_frames > 0 && pkt_bytes > 0 {
+            i64::from((len / pkt_bytes) as u32) * i64::from(pkt_frames as u32)
+        } else {
+            (len / pkt_frames.max(1)) as i64
+        };
+        if frames == 0 {
+            break;
+        }
+        entries.push(PacketEntry::slice(0, Some(pts), Some(pts), frames, true, data_offset + off, len as u32));
+        pts += frames;
+        off += len;
+    }
+    if entries.is_empty() {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "CAF has no audio packets".into() });
+    }
+    let duration = Some(pts as f64 / f64::from(rate));
+    let stream = StreamDesc {
+        index: 0,
+        kind: MediaKind::Audio,
+        codec: codec.into(),
+        time_base: (1, rate as i32),
+        channels: ch,
+        channel_layout: channel_layout_name(ch),
+        sample_rate: rate,
+        sample_fmt: sample_fmt.into(),
+        bits_per_sample: u16::try_from(bits.div_ceil(u32::from(ch))).unwrap_or(16),
+        block_align: if pkt_bytes > 0 { u16::try_from(pkt_bytes).unwrap_or(u16::MAX) } else { 0 },

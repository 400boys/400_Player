+        } else if bits_per_frame == 8 {
+            if signed { "pcm_s8" } else { "pcm_u8" }
+        } else if be {
+            match bits_per_frame {
+                16 => "pcm_s16be",
+                24 => "pcm_s24be",
+                _ => "pcm_s32be",
+            }
+        } else {
+            match bits_per_frame {
+                16 => "pcm_s16le",
+                24 => "pcm_s24le",
+                _ => "pcm_s32le",
+            }
+        };
+        let bytes_per_frame = (bits as usize).div_ceil(8) as u64;
+        (codec, "s16", (0u64, bytes_per_frame.max(1)))
+    };

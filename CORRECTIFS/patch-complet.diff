+    if tb_count == 0 || tb_count > 64 {
+        return Err(EngineError::Open { input: src.to_owned(), reason: "NUT invalid time base count".into() });
+    }
+    let mut tbs = Vec::with_capacity(tb_count);
+    for _ in 0..tb_count {
+        let num = r.v()? as i32;
+        let den = r.v()? as i32;
+        if num <= 0 || den <= 0 {
+            return Err(EngineError::Open { input: src.to_owned(), reason: "NUT invalid time base".into() });
+        }
+        tbs.push((num, den));
+    }
+    // 256 frame codes.
+    let (mut tmp_pts, mut tmp_mul, mut tmp_stream, mut tmp_size, mut tmp_head_idx) = (0i64, 1i64, 0usize, 0i64, 0usize);
+    let mut i = 0usize;
+    let mut frame_flags = [0u32; 256];
+    let mut frame_size_mul = [1u64; 256];
+    let mut frame_size_lsb = [0u64; 256];
+    let mut frame_stream = [0usize; 256];
+    let mut frame_pts_delta = [0i64; 256];
+    let mut frame_reserved = [0usize; 256];
+    let mut frame_header_idx = [0usize; 256];

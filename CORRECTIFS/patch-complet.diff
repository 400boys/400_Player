+/// Extracts real video dimensions/fps (and refines the codec) from the first video packets.
+fn ts_video_dimensions(codec: &str, entries: &[PacketEntry]) -> (u32, u32, (u32, u32), String) {
+    for e in entries.iter().filter(|e| e.stream_index == 0).take(24) {
+        let PacketPayload::Inline(data) = &e.payload else { continue };
+        if data.is_empty() {
+            continue;
+        }
+        if codec == "mpeg2video" || codec == "mpeg1video" {
+            let (w, h, fps, mpeg2) = mpeg_video_sequence_info(data);
+            if w > 0 {
+                let c = if codec == "mpeg2video" || mpeg2 { "mpeg2video" } else { "mpeg1video" };
+                return (w, h, fps, c.to_owned());
+            }
+        } else if codec == "h264" {
+            for nal in rust_h264::nal::parse_annex_b(data) {
+                if let Ok(info) = rust_h264::nal::parse_sps_info(&nal) {
+                    let fps = (info.max_reorder_frames, 0u32);
+                    let _ = fps;
+                    return (info.width.max(16), info.height.max(16), (25, 1), String::new());
+                }
+            }
+        } else if codec == "hevc" {
+            for nal in rust_h265::nal::parse_annex_b(data) {
+                if nal.nal_unit_type == rust_h265::nal::NalUnitType::Sps {
+                    if let Some((w, h)) = hevc_sps_dimensions(&nal.rbsp) {
+                        return (w.max(16), h.max(16), (25, 1), String::new());
+                    }
+                }
+            }
+        }
+    }
+    (1920, 1080, (25, 1), String::new())
+}
